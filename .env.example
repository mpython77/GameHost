# =============================================================
# GameHost — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================

# ── Server ─────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ── Admin Authentication ───────────────────────────────────────
# Strongly recommended in production. If BOTH are unset in
# NODE_ENV=production, the server does NOT exit — it generates a
# one-time RANDOM admin password, logs it loudly, and keeps running
# (so platform healthchecks stay green). That temporary password
# changes on every restart, so set these explicitly for real use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ADMIN_SECRET (HMAC signing key for admin tokens).
# If unset, the server auto-generates a random secret on first run
# and persists it to data/.admin-secret (file mode 0600).
# Set this only if you want a known/stable secret across hosts.
# ADMIN_SECRET=

# ADMIN_TOKEN_TTL_MS — how long an admin login is valid for (in ms).
# Default: 30 days (2592000000 ms). The frontend stores the token in
# localStorage so it survives tab close and browser restart, giving a
# "remembered on this device" feel. For shorter sessions (e.g. on a
# shared computer) set a smaller value:
#   8 hours   = 28800000
#   24 hours  = 86400000
#   7 days    = 604800000
# ADMIN_TOKEN_TTL_MS=2592000000

# ── Storage ────────────────────────────────────────────────────
# Where game files and the JSON DB live. On Railway, mount the
# volume at this path (e.g. /app/data) and set DATA_DIR to it.
# Defaults to ./data when unset.
# DATA_DIR=/app/data

# ── Optional: Public URL ───────────────────────────────────────
# Used in QR codes and share links when behind a proxy with
# different host. Defaults to request host.
# PUBLIC_BASE_URL=https://games.example.com

# ── Optional: Games origin (iframe isolation) ──────────────────
# Origin that serves the uploaded games (the /games/* iframe).
# Leave unset to serve games from the SAME origin as the app
# (relies on the iframe sandbox attribute for isolation).
#
# For STRONG isolation, point this at a SEPARATE origin (e.g. a
# dedicated subdomain running this same app). A cross-origin iframe
# cannot reach window.parent, so a malicious uploaded game cannot
# read the host page's admin token even with allow-same-origin.
# GAMES_BASE_URL=https://games.example.com

# ── Optional: Analytics log rotation ───────────────────────────
# data/events.jsonl is rolled over once it exceeds this size; up to
# EVENTS_LOG_MAX_FILES archives (events.jsonl.1 .. .N) are kept and
# re-read on startup so daily aggregates stay complete.
# EVENTS_LOG_MAX_BYTES=10485760   # 10 MB
# EVENTS_LOG_MAX_FILES=3

# ── Optional: Play-count rate limit ────────────────────────────
# Max counted plays per IP+game per hour (anti-inflation). Default 30.
# PLAY_RATE_LIMIT=30
