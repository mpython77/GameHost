# GameHost — Environment Variables
# Bu faylni .env deb nusxalab, qiymatlarni o'zgartiring

# Server
PORT=8080
NODE_ENV=production

# Admin login va paroli (default: admin / admin)
# MUHIM: Production da albatta o'zgartiring!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Admin JWT secret (random uzun string kiriting)
ADMIN_SECRET=your-very-long-random-secret-here-change-this

# Ma'lumotlar joylashuvi (Railway Volume uchun)
# DATA_DIR=/data
